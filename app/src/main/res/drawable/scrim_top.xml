<?xml version="1.0" encoding="utf-8"?>
<!-- Radial from the top-left corner; fully transparent before it reaches any edge of the view. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android">
    <gradient
        android:centerColor="#26000000"
        android:centerX="0"
        android:centerY="0"
        android:endColor="#00000000"
        android:gradientRadius="100%"
        android:startColor="#73000000"
        android:type="radial" />
</shape>
