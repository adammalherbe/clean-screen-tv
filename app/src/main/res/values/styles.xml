<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.CleanScreenTV" parent="@android:style/Theme.Material.NoActionBar.Fullscreen">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:windowShowWallpaper">false</item>
        <item name="android:colorAccent">#FFFFFFFF</item>
    </style>

    <style name="HomeText">
        <item name="android:textColor">#FFFFFFFF</item>
        <item name="android:shadowColor">#59000000</item>
        <item name="android:shadowDy">2</item>
        <item name="android:shadowRadius">14</item>
        <item name="android:includeFontPadding">false</item>
    </style>
</resources>
